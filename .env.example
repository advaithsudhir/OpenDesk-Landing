# Formspree endpoint for the "leave your details" contact form.
# Sign up free at https://formspree.io, create a form, and paste its
# endpoint URL here (looks like https://formspree.io/f/xxxxxxxx).
# Without this set, the form shows a fallback mailto link instead.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Supabase project credentials, used for real login at /login and /app.
# Find both in Supabase Dashboard > Settings > API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "anon / public" key — never paste the
# service_role key here or anywhere in the client-side app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase Dashboard > Settings > API), used ONLY by the
# weekly-digest cron route (app/api/cron/weekly-digest) to read every
# clinic's data in one background run. Bypasses RLS — never expose this to
# the client, never prefix it with NEXT_PUBLIC_, never use it anywhere a
# logged-in user's own Supabase client would do instead.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (resend.com), used to send the weekly digest email.
# Requires getopendesk.com to be a verified sending domain in Resend.
RESEND_API_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# triggers /api/cron/weekly-digest — without this, anyone who found the URL
# could trigger emails to every clinic on demand. Generate any long random
# string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# and set the same value in Vercel's environment variables.
CRON_SECRET=
