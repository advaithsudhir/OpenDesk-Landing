# Formspree endpoint for the "leave your details" contact form.
# Sign up free at https://formspree.io, create a form, and paste its
# endpoint URL here (looks like https://formspree.io/f/xxxxxxxx).
# Without this set, the form shows a fallback mailto link instead.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Supabase project credentials, used for real login at /login and /app.
# Find both in Supabase Dashboard > Settings > API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "anon / public" key — never paste the
# service_role key here or anywhere in the client-side app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
